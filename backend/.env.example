# Copy this file to .env and fill in the values. .env is gitignored.

# Gnani ASR (https://app.gnani.ai) - sent as the X-API-Key-ID header
GNANI_API_KEY=

# Gemini (https://aistudio.google.com/apikey) - used for the summary
GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-lite-latest

# Supabase Postgres connection string. Use the "Session pooler" URI (works over IPv4).
DATABASE_URL=

# Supabase Storage: project URL, the secret (service role) key, and a private bucket
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=audio

# Largest upload accepted, in MB (Supabase free tier allows 50 MB per file)
MAX_UPLOAD_MB=50

# "true": the worker runs as a thread inside the API. "false": run `python worker.py` yourself.
RUN_WORKER_IN_API=true

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
